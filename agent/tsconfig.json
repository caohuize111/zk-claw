{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["*.ts", "transport/*.ts", "storage/*.ts", "bundler/*.ts"],
  "exclude": ["node_modules", "dist"]
}
